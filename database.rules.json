{
  "rules": {
    "colleges": {
      "$collegeId": {
        // 🔒 ZERO-TRUST SECURITY: 
        // Only users with a matching cryptographically-signed collegeId in their token can read/write.
        ".read": "auth.token.collegeId === $collegeId",
        ".write": "auth.token.collegeId === $collegeId && root.child('colleges').child($collegeId).child('subscription').child('status').val() !== 'paused'",
        
        "subscription": {
          ".read": "auth != null",
          ".write": "false" // Only Cloud Functions (Razorpay Webhook) can update status
        },
        
        "logs": {
          ".write": "auth.token.collegeId === $collegeId && auth.token.role === 'admin'"
        },
        
        "students": {
           "$studentId": {
              ".validate": "newData.hasChildren(['id', 'name'])"
           }
        }
      }
    }
  }
}
